# EventGenie AI - Environment Configuration Example
# Copy this file to .env or configure in your environment / platform secret manager.

# Google Gemini API Key (Optional for Smart Demo Mode; Required for Live GenAI generation)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Preferred Gemini Model (Defaults to gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# HTTP Server Port (Default: 8000)
PORT=8000
